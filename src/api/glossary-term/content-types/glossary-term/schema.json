{
  "kind": "collectionType",
  "collectionName": "glossary_terms",
  "info": {
    "singularName": "glossary-term",
    "pluralName": "glossary-terms",
    "displayName": "Glossary Term",
    "description": "One term: a definition, plus any labeled rows it needs. Pick the glossary it belongs to."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "term": {
      "type": "string",
      "required": true
    },
    "anchor": {
      "type": "uid",
      "targetField": "term",
      "required": true
    },
    "glossary": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::glossary.glossary",
      "inversedBy": "terms"
    },
    "definition": {
      "type": "richtext",
      "required": true
    },
    "details": {
      "type": "component",
      "repeatable": true,
      "component": "glossary.detail"
    }
  }
}
