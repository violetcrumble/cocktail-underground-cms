{
  "kind": "collectionType",
  "collectionName": "partner_categories",
  "info": {
    "singularName": "partner-category",
    "pluralName": "partner-categories",
    "displayName": "Partner Category",
    "description": "Groups affiliate partners (THC drinks, drinks, gear) so each page shows the right set"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "handle": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "affiliate_partners": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::affiliate-partner.affiliate-partner",
      "mappedBy": "category"
    }
  }
}
